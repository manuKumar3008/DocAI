	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-ai.version>1.1.2</spring-ai.version>
		<spring-cloud.version>2025.0.0</spring-cloud.version>
		<tika.version>3.2.3</tika.version>
		<pdfbox.version>3.0.5</pdfbox.version>
		<lombok.version>1.18.38</lombok.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- WebFlux is added alongside spring-boot-starter-web (not instead of it).
		     Spring Boot detects both and keeps the servlet/Tomcat stack as primary.
		     This unlocks two things:
		       1. Flux<String> return types in @RestController for SSE streaming.
		       2. WebTestClient (via MockMvcWebTestClient) in tests. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-mistral-ai</artifactId>
		</dependency>
		<dependency>
